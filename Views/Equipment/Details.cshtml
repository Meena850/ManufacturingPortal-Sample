@model Equipment
@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>

<dl class="row">
    <dt class="col-sm-3">Asset Tag</dt>
    <dd class="col-sm-9">@Model.AssetTag</dd>
    <dt class="col-sm-3">Production Line</dt>
    <dd class="col-sm-9">@Model.ProductionLine</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="status-@Model.Status.ToLower()">@Model.Status</span></dd>
    <dt class="col-sm-3">Last Maintenance</dt>
    <dd class="col-sm-9">@Model.LastMaintenanceDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Next Maintenance</dt>
    <dd class="col-sm-9">@Model.NextMaintenanceDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<a asp-action="List" class="btn btn-secondary">Back to list</a>
